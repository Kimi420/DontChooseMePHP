# Statisches Ausliefern + SPA Fallback + Backend Weiterleitung
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Bereits existierende Dateien / Verzeichnisse direkt ausliefern
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Backend-Endpunkte direkt durchreichen (PHP-Dateien in backend/)
  RewriteRule ^backend/(.*)$ backend/$1 [L]

  # Alles andere an index.php (SPA Router)
  RewriteRule ^ index.php [L]
</IfModule>

# Gzip / Brotli Hints (optional – tatsächliche Komprimierung Serverseitig aktivieren)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# Caching für statische Assets
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType audio/mpeg "access plus 30 days"
</IfModule>

